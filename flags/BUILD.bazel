load("@bazel_skylib//rules:common_settings.bzl", "bool_flag", "string_flag")
load("//tools:flavour_constants.bzl", "KNOWN_FLAVOURS")

package(default_visibility = ["//visibility:public"])

# Set to true by the Gerrit source tree .bazelrc. Defaults to false for
# standalone plugin workspaces.
bool_flag(
    name = "in_gerrit_tree",
    build_setting_default = False,
)

config_setting(
    name = "in_gerrit_tree_enabled",
    flag_values = {":in_gerrit_tree": "true"},
)

# Servlet flavour of the build: "ee8" (default, javax.servlet) or "ee10"
# (jakarta.servlet). Lives here (not in Gerrit) so the shared gerrit_plugin
# `flavour = "ee10"` attribute can transition its own target onto it -- letting
# an EE10 plugin be built directly (`bazelisk build //plugins/foo:foo-ee10`)
# alongside its EE8 sibling in a single invocation. Gerrit's //tools:ee10
# config_setting and ee10_war transition key off this flag.
string_flag(
    name = "flavour",
    build_setting_default = "ee8",
    values = KNOWN_FLAVOURS,
)

config_setting(
    name = "ee8",
    flag_values = {":flavour": "ee8"},
)

config_setting(
    name = "ee10",
    flag_values = {":flavour": "ee10"},
)

# Toolchain type for the servlet-flavour toolchain (tools/servlet_flavour.bzl):
# consuming rules depend on this type and Bazel resolves the concrete per-flavour
# toolchain whose `target_settings` match the active `:flavour` value.
toolchain_type(name = "servlet_flavour_toolchain_type")
